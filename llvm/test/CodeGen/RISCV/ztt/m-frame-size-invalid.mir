# RUN: not --crash llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -run-pass=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-6.mir -o - 2>&1 | FileCheck %s --check-prefix=ALIAS
# PARAM: LLVM ERROR: invalid Ztt M frame size parameters
# ALIAS: LLVM ERROR: Ztt M frame size registers overlap

#--- negative.mir
--- |
  define void @negative() "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: negative
tracksRegLiveness: true
body: |
  bb.0:
    early-clobber $x10, early-clobber $x11, early-clobber $x12, early-clobber $x13, early-clobber $x14 = PseudoZTTMFrameSize -1, 16
    PseudoRET implicit $x10, implicit $x11
...

#--- count_overflow.mir
--- |
  define void @count_overflow() "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: count_overflow
tracksRegLiveness: true
body: |
  bb.0:
    early-clobber $x10, early-clobber $x11, early-clobber $x12, early-clobber $x13, early-clobber $x14 = PseudoZTTMFrameSize 2147483648, 16
    PseudoRET implicit $x10, implicit $x11
...

