# RUN: not --crash llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -run-pass=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-3.mir -o - 2>&1 | FileCheck %s --check-prefix=PARAM
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u128-m32-a16/g' %t/under_align.mir > %t.ztt-profile-4.mir
# RUN: not --crash llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -run-pass=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-4.mir -o - 2>&1 | FileCheck %s --check-prefix=PARAM
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m32-a16/g' %t/large_align.mir > %t.ztt-profile-5.mir
# RUN: not --crash llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -run-pass=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-5.mir -o - 2>&1 | FileCheck %s --check-prefix=PARAM
