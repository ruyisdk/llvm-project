# RUN: split-file %s %t
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m32-a16/g' %t/negative.mir > %t.ztt-profile-0.mir
# RUN: not --crash llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -run-pass=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-0.mir -o - 2>&1 | FileCheck %s --check-prefix=PARAM
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m32-a16/g' %t/count_overflow.mir > %t.ztt-profile-1.mir
# RUN: not --crash llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -run-pass=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-1.mir -o - 2>&1 | FileCheck %s --check-prefix=PARAM
