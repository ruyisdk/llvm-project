# Four ACC squares reload at acc5, not a multiple of four (or pack factor
# two). The M transfer still starts at an aligned M register, independently.
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u32-m16-a16/g' %s > %t.ztt-profile-0.mir
# RUN: llc -mtriple=riscv32 -mattr=+m,+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-0.mir -o %t.32.s
# RUN: FileCheck %s --match-full-lines --check-prefix=RV32 < %t.32.s
# RUN: %python %S/Inputs/check-spill-frame.py %t.32.s 32 acc_image_unaligned 16 4 32
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u32-m16-a16/g' %s > %t.ztt-profile-1.mir
# RUN: llc -mtriple=riscv64 -mattr=+m,+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-1.mir -o %t.64.s
# RUN: FileCheck %s --match-full-lines --check-prefix=RV64 < %t.64.s
# RUN: %python %S/Inputs/check-spill-frame.py %t.64.s 64 acc_image_unaligned 16 4 32
--- |
  define void @acc_image_unaligned() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: acc_image_unaligned
tracksRegLiveness: true
stack:
  - { id: 0, size: 8, alignment: 4 }
body: |
  bb.0:
    liveins: $ztta0m4
    PseudoZTTASpillA4 $ztta0m4, %stack.0, 16
    $ztta5m4 = PseudoZTTAReloadA4 %stack.0, 16
    PseudoRET implicit $ztta5m4
...

