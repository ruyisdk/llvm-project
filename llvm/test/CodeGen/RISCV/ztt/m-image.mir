# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m32-a16/g' %s > %t.ztt-profile-0.mir
# RUN: llc -mtriple=riscv32 -mattr=+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-0.mir -o - | FileCheck %s
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m32-a16/g' %s > %t.ztt-profile-1.mir
# RUN: llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-1.mir -o - | FileCheck %s

# The addresses/physical-register byte stride are supplied, not allocated here.
# Expected counts follow the spec: G/W Md words, G whole-register transfers.
# Metadata restoration precedes every data load, including all wide tails.
--- |
  define void @image_g1_w1() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
  define void @image_g2_w1() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
  define void @image_g4_w1() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
  define void @image_g8_w1() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
  define void @image_g16_w1() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
  define void @image_g32_w1() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
  define void @image_g4_w4() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
  define void @image_g8_w4() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
  define void @image_g16_w16() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
  define void @image_g32_w16() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: image_g1_w1
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $zttm0, $x10, $x11, $x12
    ; CHECK-LABEL: image_g1_w1:
    ; CHECK-NEXT: # %bb.0:
    ; CHECK-NEXT: mgettyp a4, m0
    ; CHECK-NEXT: sw a4, 0(a1)
    ; CHECK-NEXT: mv a3, a0
    ; CHECK-NEXT: mss.1r m0, a3
    ; CHECK-NEXT: lw a4, 0(a1)
    ; CHECK-NEXT: msettyp m1, a4
    ; CHECK-NEXT: mls.1r m1, a3
    ; CHECK-NEXT: ret
    early-clobber $x13, early-clobber $x14 = PseudoZTTMSaveM1 $zttm0, $x10, $x11, $x12, 1
    $zttm1, early-clobber $x13, early-clobber $x14 = PseudoZTTMRestoreM1 $x10, $x11, $x12, 1
    PseudoRET implicit $zttm1
...
---
name: image_g2_w1
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $zttm0m2, $x10, $x11, $x12
    ; CHECK-LABEL: image_g2_w1:
    ; CHECK-NEXT: # %bb.0:
    ; CHECK-NEXT: mgettyp a4, m0
    ; CHECK-NEXT: sw a4, 0(a1)
    ; CHECK-NEXT: mgettyp a4, m1
    ; CHECK-NEXT: sw a4, 4(a1)
    ; CHECK-NEXT: mv a3, a0
    ; CHECK-NEXT: mss.1r m0, a3
    ; CHECK-NEXT: add a3, a3, a2
    ; CHECK-NEXT: mss.1r m1, a3
    ; CHECK-NEXT: lw a4, 0(a1)
    ; CHECK-NEXT: msettyp m2, a4
    ; CHECK-NEXT: lw a4, 4(a1)
    ; CHECK-NEXT: msettyp m3, a4
    ; CHECK-NEXT: mv a3, a0
    ; CHECK-NEXT: mls.1r m2, a3
    ; CHECK-NEXT: add a3, a3, a2
    ; CHECK-NEXT: mls.1r m3, a3
    ; CHECK-NEXT: ret
    early-clobber $x13, early-clobber $x14 = PseudoZTTMSaveM2 $zttm0m2, $x10, $x11, $x12, 1
    $zttm2m2, early-clobber $x13, early-clobber $x14 = PseudoZTTMRestoreM2 $x10, $x11, $x12, 1
    PseudoRET implicit $zttm2m2
...
