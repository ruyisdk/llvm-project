# RUN: sed -e 's/SD /SW /g' -e 's/LD /LW /g' -e 's/s64/s32/g' %s > %t.32.mir
# ACC and GPR lifetimes do not overlap. Stack coloring may share their FI;
# preserving Ad must not shrink the existing 8-byte scalar slot or alignment.
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u64-m16-a16/g' %t.32.mir > %t.ztt-profile-0.mir
# RUN: llc -mtriple=riscv32 -mattr=+m,+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-0.mir -o %t.32.s
# RUN: FileCheck %s --match-full-lines --check-prefix=RV32 < %t.32.s
# RUN: %python %S/Inputs/check-spill-frame.py %t.32.s 32 acc_image_colored 64 1 64
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u64-m16-a16/g' %s > %t.ztt-profile-1.mir
# RUN: llc -mtriple=riscv64 -mattr=+m,+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-1.mir -o %t.64.s
# RUN: FileCheck %s --match-full-lines --check-prefix=RV64 < %t.64.s
# RUN: %python %S/Inputs/check-spill-frame.py %t.64.s 64 acc_image_colored 64 1 64
--- |
  define void @acc_image_colored() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: acc_image_colored
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $ztta0, $x10
    PseudoZTTASpillA1 $ztta0, %stack.0, 64
    $ztta8 = PseudoZTTAReloadA1 %stack.0, 64
    SD $x10, %stack.0, 0 :: (store (s64) into %stack.0)
    $x10 = LD %stack.0, 0 :: (load (s64) from %stack.0)
    PseudoRET implicit $ztta8, implicit $x10
...

