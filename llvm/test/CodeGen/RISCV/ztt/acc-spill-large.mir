# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m16-a16/g' %s > %t.ztt-profile-0.mir
# RUN: llc -mtriple=riscv32 -mattr=+m,+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-0.mir -o %t.32.s
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m16-a16/g' %s > %t.ztt-profile-1.mir
# RUN: llc -mtriple=riscv64 -mattr=+m,+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-1.mir -o %t.64.s
# RUN: FileCheck %s --match-full-lines --check-prefix=RV32 < %t.32.s
# RUN: FileCheck %s --match-full-lines --check-prefix=RV64 < %t.64.s
# RUN: %python %S/Inputs/check-spill-frame.py %t.32.s 32 acc_image_large 128 8 8
# RUN: %python %S/Inputs/check-spill-frame.py %t.64.s 64 acc_image_large 128 8 8
# An eight-square ACC value needs 128 physical M images but the machine has
# only 16 M registers. Transfer eight batches, without inventing a 128-M group.
--- |
  define void @acc_image_large() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: acc_image_large
tracksRegLiveness: true
stack:
  - { id: 0, size: 16, alignment: 4 }
body: |
  bb.0:
    liveins: $ztta0m8
    PseudoZTTASpillA8 $ztta0m8, %stack.0, 128
    $ztta8m8 = PseudoZTTAReloadA8 %stack.0, 128
    PseudoRET implicit $ztta8m8
...

