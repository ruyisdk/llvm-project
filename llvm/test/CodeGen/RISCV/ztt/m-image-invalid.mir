# RUN: split-file %s %t
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m32-a16/g' %t/zero.mir > %t.ztt-profile-0.mir
# RUN: not --crash llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -run-pass=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-0.mir -o - 2>&1 | FileCheck %s --check-prefix=WIDTH
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m32-a16/g' %t/nonpower.mir > %t.ztt-profile-1.mir
# RUN: not --crash llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -run-pass=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-1.mir -o - 2>&1 | FileCheck %s --check-prefix=WIDTH
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m32-a16/g' %t/oversize.mir > %t.ztt-profile-2.mir
# RUN: not --crash llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -run-pass=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-2.mir -o - 2>&1 | FileCheck %s --check-prefix=WIDTH
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m32-a16/g' %t/scratch.mir > %t.ztt-profile-3.mir
# RUN: not --crash llc -mtriple=riscv64 -mattr=+ztt -verify-machineinstrs -run-pass=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-3.mir -o - 2>&1 | FileCheck %s --check-prefix=ALIAS
# WIDTH: LLVM ERROR: invalid Ztt M save/restore square width
# ALIAS: LLVM ERROR: Ztt M save/restore scratch overlaps an input

#--- zero.mir
--- |
  define void @zero() "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: zero
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11, $x12
    $zttm0m4, early-clobber $x13, early-clobber $x14 = PseudoZTTMRestoreM4 $x10, $x11, $x12, 0
    PseudoRET implicit $zttm0m4
...

#--- nonpower.mir
--- |
  define void @nonpower() "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: nonpower
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11, $x12
    $zttm0m4, early-clobber $x13, early-clobber $x14 = PseudoZTTMRestoreM4 $x10, $x11, $x12, 3
    PseudoRET implicit $zttm0m4
...

#--- oversize.mir
--- |
  define void @oversize() "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: oversize
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11, $x12
    $zttm0m4, early-clobber $x13, early-clobber $x14 = PseudoZTTMRestoreM4 $x10, $x11, $x12, 8
    PseudoRET implicit $zttm0m4
...

#--- scratch.mir
--- |
  define void @scratch() "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: scratch
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11, $x12
    $zttm0m4, early-clobber $x13, early-clobber $x10 = PseudoZTTMRestoreM4 $x10, $x11, $x12, 4
    PseudoRET implicit $zttm0m4
...
