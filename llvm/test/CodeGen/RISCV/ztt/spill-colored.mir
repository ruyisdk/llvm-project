# RUN: sed -e 's/SD /SW /g' -e 's/LD /LW /g' -e 's/s64/s32/g' %s > %t.32.mir
# The M and scalar images have disjoint lifetimes but share a colored FI.
# Its 8-byte capacity/alignment must survive the 4-byte Md requirement.
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u32-m16-a4/g' %t.32.mir > %t.ztt-profile-0.mir
# RUN: llc -mtriple=riscv32 -mattr=+m,+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo -stop-after=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-0.mir -o - | FileCheck %s --check-prefix=SLOT
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u32-m16-a4/g' %s > %t.ztt-profile-1.mir
# RUN: llc -mtriple=riscv64 -mattr=+m,+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo -stop-after=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-1.mir -o - | FileCheck %s --check-prefix=SLOT
# SLOT: id: 0, name: '', type: spill-slot, offset: 0, size: 8, alignment: 8,
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u32-m16-a4/g' %t.32.mir > %t.ztt-profile-2.mir
# RUN: llc -mtriple=riscv32 -mattr=+m,+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-2.mir -o %t.32.s
# RUN: FileCheck %s --match-full-lines --check-prefix=RV32 < %t.32.s
# RUN: %python %S/Inputs/check-spill-frame.py %t.32.s 32 busy 32 1 32
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u32-m16-a4/g' %s > %t.ztt-profile-3.mir
# RUN: llc -mtriple=riscv64 -mattr=+m,+ztt -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-3.mir -o %t.64.s
# RUN: FileCheck %s --match-full-lines --check-prefix=RV64 < %t.64.s
# RUN: %python %S/Inputs/check-spill-frame.py %t.64.s 64 busy 32 1 32
--- |
  define void @busy() nounwind "riscv-ztt-profile"="ZTT_PROFILE" { ret void }
...
---
name: busy
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
  - { id: 1, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $zttm0, $x10, $x11
    SD $x11, %stack.1, 0 :: (store (s64) into %stack.1)
    PseudoZTTMSpillM1 $zttm0, %stack.0, 1
    $zttm0 = PseudoZTTMReloadM1 %stack.0, 1
    SD $x10, %stack.0, 0 :: (store (s64) into %stack.0)
    $x10 = LD %stack.0, 0 :: (load (s64) from %stack.0)
    $x11 = LD %stack.1, 0 :: (load (s64) from %stack.1)
    PseudoRET implicit $zttm0, implicit $x10, implicit $x11
...

