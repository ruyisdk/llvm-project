# RUN: llc -mtriple=riscv32 -mattr=+m -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %s -o %t.32.s
# RUN: llc -mtriple=riscv64 -mattr=+m -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %s -o %t.64.s
# RUN: FileCheck %s --match-full-lines --check-prefix=RV32 < %t.32.s
# RUN: FileCheck %s --match-full-lines --check-prefix=RV64 < %t.64.s
# RUN: %python %S/Inputs/check-spill-frame.py %t.32.s 32 acc_image_packed 4 8 32
# RUN: %python %S/Inputs/check-spill-frame.py %t.64.s 64 acc_image_packed 4 8 32
# RUN: %python %S/Inputs/check-spill-frame.py %t.32.s 32 acc_image_unsigned 32 2 16
# RUN: %python %S/Inputs/check-spill-frame.py %t.64.s 64 acc_image_unsigned 32 2 16
# RUN: %python %S/Inputs/check-spill-frame.py %t.32.s 32 acc_image_standard 64 1 64
# RUN: %python %S/Inputs/check-spill-frame.py %t.64.s 64 acc_image_standard 64 1 64
# Test raw Ad preservation (including unsigned), sub-byte packed squares,
# and reload to a different nonzero ACC register.
--- |
  define void @acc_image_packed() nounwind "target-features"="+ztt" "riscv-ztt-profile"="clang-runtime-u32-m16-a16" { ret void }
  define void @acc_image_unsigned() nounwind "target-features"="+ztt" "riscv-ztt-profile"="clang-runtime-u16-m16-a16" { ret void }
  define void @acc_image_standard() nounwind "target-features"="+ztt" "riscv-ztt-profile"="clang-runtime-u64-m16-a16" { ret void }
...
---
name: acc_image_packed
tracksRegLiveness: true
stack:
  - { id: 0, size: 16, alignment: 4 }
body: |
  bb.0:
    liveins: $ztta0m8
    PseudoZTTASpillA8 $ztta0m8, %stack.0, 4
    $ztta8m8 = PseudoZTTAReloadA8 %stack.0, 4
    PseudoRET implicit $ztta8m8
...
---
name: acc_image_unsigned
tracksRegLiveness: true
stack:
  - { id: 0, size: 4, alignment: 4 }
body: |
  bb.0:
    liveins: $ztta0m2
    PseudoZTTASpillA2 $ztta0m2, %stack.0, 32
    $ztta8m2 = PseudoZTTAReloadA2 %stack.0, 32
    PseudoRET implicit $ztta8m2
...
---
name: acc_image_standard
tracksRegLiveness: true
stack:
  - { id: 0, size: 2, alignment: 4 }
body: |
  bb.0:
    liveins: $ztta0
    PseudoZTTASpillA1 $ztta0, %stack.0, 64
    $ztta8 = PseudoZTTAReloadA1 %stack.0, 64
    PseudoRET implicit $ztta8
...

