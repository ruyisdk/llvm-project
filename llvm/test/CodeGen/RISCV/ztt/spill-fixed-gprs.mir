# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m16-a4/g' %s > %t.ztt-profile-0.mir
# RUN: llc -mtriple=riscv32 -mattr=+m,+ztt,+reserve-x10,+reserve-x11,+reserve-x12 -verify-machineinstrs -start-before=riscv-ztt-post-ra-expand-pseudo %t.ztt-profile-0.mir -o %t.rv32.s
# RUN: FileCheck %s --check-prefix=RV32 < %t.rv32.s
# RUN: %python %S/Inputs/check-spill-frame.py %t.rv32.s 32 busy 32 1 8 0 a0,a1,a2
# RUN: sed 's/ZTT_PROFILE/clang-runtime-u8-m16-a4/g' %s > %t.ztt-profile-1.mir
