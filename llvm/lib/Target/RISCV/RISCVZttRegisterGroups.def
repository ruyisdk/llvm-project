//===----------------------------------------------------------------------===//
// Physical group sizes and register classes, shared by layout and spill code.

#ifndef RISCV_ZTT_M_GROUP
#define RISCV_ZTT_M_GROUP(Size, Class)
#endif
#ifndef RISCV_ZTT_ACC_GROUP
#define RISCV_ZTT_ACC_GROUP(Size, Class)
#endif

RISCV_ZTT_M_GROUP(1, ZTTMRRegClass)
RISCV_ZTT_M_GROUP(2, ZTTMRM2RegClass)
RISCV_ZTT_M_GROUP(4, ZTTMRM4RegClass)
RISCV_ZTT_M_GROUP(8, ZTTMRM8RegClass)
RISCV_ZTT_M_GROUP(16, ZTTMRM16RegClass)
RISCV_ZTT_M_GROUP(32, ZTTMRM32RegClass)

RISCV_ZTT_ACC_GROUP(1, ZTTARRegClass)
RISCV_ZTT_ACC_GROUP(2, ZTTARM2RegClass)
RISCV_ZTT_ACC_GROUP(4, ZTTARM4RegClass)
RISCV_ZTT_ACC_GROUP(8, ZTTARM8RegClass)

#undef RISCV_ZTT_M_GROUP
#undef RISCV_ZTT_ACC_GROUP
